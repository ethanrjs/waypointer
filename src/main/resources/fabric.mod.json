{
    "schemaVersion": 1,
    "id": "waypointer",
    "version": "${version}",
    "name": "Waypointer",
  "description": "Best waypoint mod for Hypixel SkyBlock.",
    "authors": ["Babbur"],
    "contact": {
        "homepage": "https://github.com/ethanrjs/waypointer#readme",
        "sources": "https://github.com/ethanrjs/waypointer",
        "issues": "https://github.com/ethanrjs/waypointer/issues"
    },
    "license": "PolyForm-Noncommercial-1.0.0",
    "icon": "assets/waypointer/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": ["com.babbur.waypointer.Waypointer"],
        "client": ["com.babbur.waypointer.WaypointerClient"]
    },
    "mixins": [
        {
            "config": "waypointer.client.mixins.json",
            "environment": "client"
        }
    ],
    "accessWidener": "waypointer.accesswidener",
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "${minecraft_dependency}",
        "java": ">=25",
        "fabric-api": "*",
        "hypixel-mod-api": ">=1.0.2"
    }
}
